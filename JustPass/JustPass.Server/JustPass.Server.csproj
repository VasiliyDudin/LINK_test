<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<SpaRoot>..\justpass.client</SpaRoot>
		<SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
		<SpaProxyServerUrl>https://localhost:55625</SpaProxyServerUrl>
	</PropertyGroup>

	<ItemGroup>
		<!-- Используем версию 2.7.5, совместимую с Swashbuckle -->
		<PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
		<PackageReference Include="Microsoft.AspNetCore.SpaProxy">
			<Version>10.*-*</Version>
		</PackageReference>
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
	</ItemGroup>

	<!-- Ссылка на клиентский проект закомментирована, так как он не нужен в Docker -->
	<!--
  <ItemGroup>
    <ProjectReference Include="..\justpass.client\justpass.client.esproj" />
  </ItemGroup>
  -->

</Project>